# ============================================
#  Lunchify server — environment template
#  Copy to .env and fill in. .env is git-ignored.
# ============================================

# --- Azul Tech SSO (Keycloak) ---
KEYCLOAK_ISSUER=http://localhost:8081/realms/azultech
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/azultech/protocol/openid-connect/certs
KEYCLOAK_ALLOWED_AZP=lunchify

# --- Company identity ---
ALLOWED_EMAIL_DOMAIN=azultech.rw

# --- Data store ---
DATA_FILE=./data/lunchify.json
ORG_NAME=Azul Tech
BOOTSTRAP_ADMIN_EMAILS=admin@azultech.rw
SEED_DEMO=false

# --- Server ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Secrets (generate strong random values for production) ---
JWT_SECRET=change-me
SESSION_SECRET=change-me

# --- Legacy Google OAuth (unused with Keycloak) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
