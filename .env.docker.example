# Lunchify container runtime env — copy to .env.docker and fill in.
# (Build-time VITE_* values are passed separately; see docker-compose.yml.)

NODE_ENV=production
PORT=3001

# Public URL the browser loads Lunchify from
FRONTEND_URL=https://lunch.azultech.rw

# --- Azul Tech SSO (Keycloak) — use the PUBLIC Keycloak URL ---
KEYCLOAK_ISSUER=https://sso.azultech.rw/realms/azul-tech
KEYCLOAK_JWKS_URI=https://sso.azultech.rw/realms/azul-tech/protocol/openid-connect/certs
KEYCLOAK_ALLOWED_AZP=lunchify

# --- Company identity ---
ALLOWED_EMAIL_DOMAIN=azultech.rw

# --- Data ---
DATA_FILE=/app/server/data/lunchify.json
ORG_NAME=Azul Tech
BOOTSTRAP_ADMIN_EMAILS=u.yvonne@azultech.rw
SEED_DEMO=false

# --- Secrets: generate with `openssl rand -hex 32` ---
JWT_SECRET=
SESSION_SECRET=

# Also pass these as build args (docker compose build):
#   VITE_KEYCLOAK_URL=https://sso.azultech.rw
#   VITE_KEYCLOAK_REALM=azul-tech
#   VITE_KEYCLOAK_CLIENT_ID=lunchify
#   VITE_KEYCLOAK_IDP_HINT=zoho
